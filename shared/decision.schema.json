{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flagzero.local/schemas/decision.schema.json",
  "title": "Decision",
  "description": "The fused/decided flag state that /core publishes to the dashboard, and derives serial commands to the UNO from.",
  "type": "object",
  "required": ["severity", "label", "fused_confidence", "medical_response", "location", "track_position_m"],
  "properties": {
    "severity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "label": {
      "type": "string",
      "enum": ["NORMAL", "CAUTION", "YELLOW", "DOUBLE_YELLOW", "SLOW_ZONE", "RED_FLAG_RECOMMENDED"]
    },
    "fused_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "medical_response": {
      "type": "boolean"
    },
    "location": {
      "type": "string"
    },
    "track_position_m": {
      "type": "number",
      "minimum": 0
    },
    "car_id": {
      "type": "integer",
      "description": "Optional -- omit for track-wide decisions (e.g. a general SLOW_ZONE) that aren't about one car."
    },
    "timestamp": {
      "type": "number"
    },
    "contributing_incident_ids": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Incident.id values that fed this decision, for traceability."
    }
  },
  "additionalProperties": false
}
